spring:
  application:
    name: board
  datasource:
    url: jdbc:mysql://localhost:3306/simpleboard?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: 여기에_비밀번호
  sql:
    init:
      mode: always          # 시작 시 schema.sql 실행 (CREATE TABLE IF NOT EXISTS)
  servlet:
    multipart:
      max-file-size: 10MB     # 첨부 파일 1개 최대 10MB (F-10)
      max-request-size: 11MB  # 파일 10MB + 제목/본문
server:
  tomcat:
    max-swallow-size: 100MB   # 용량 초과 요청도 끝까지 읽어서 안내 페이지를 보여주기 위함
  port: 8070
  servlet:
    session:
      timeout: 30m
      tracking-modes: cookie   # URL에 ;jsessionid 붙지 않게
      cookie:
        http-only: true
        same-site: lax         # CSRF 완화 (Spring Security CSRF 토큰 대신)
file:
  upload-dir: ./uploads              # 첨부 파일 저장 경로 (git 제외)
